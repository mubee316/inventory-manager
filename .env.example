# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Copy this file to .env.local and fill in the values from project "hi-m-d3503".
# These are inlined into the client bundle at build time, so they must be present
# in the environment for `npm run build` as well as `npm run dev`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
